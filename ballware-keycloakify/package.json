{
    "name": "ballware-keycloakify",
    "version": "1.0.0",
    "description": "Keycloakify login theme for ballware (DevExtreme + React)",
    "type": "module",
    "scripts": {
        "postinstall": "keycloakify sync-extensions",
        "dev": "vite",
        "build": "tsc && vite build",
        "build-keycloak-theme": "npm run build && keycloakify build",
        "lint": "eslint .",
        "e2e": "playwright test",
        "license:lcp": "devextreme-license --out license-key.local.txt --no-gitignore --force",
        "storybook": "storybook dev -p 6006",
        "format": "prettier . --write"
    },
    "license": "MIT",
    "keywords": [],
    "dependencies": {
        "@keycloakify/keycloak-account-ui": "~260700.0.4",
        "bootstrap": "^5.3.3",
        "devextreme": "26.1.6",
        "devextreme-react": "26.1.6",
        "keycloakify": "^11.16.4",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "@keycloakify/keycloak-ui-shared": "~260700.0.3",
        "@patternfly/patternfly": "^5.4.2",
        "@patternfly/react-core": "^5.4.14",
        "@patternfly/react-icons": "^5.4.2",
        "@patternfly/react-table": "^5.4.16",
        "i18next": "^25.7.3",
        "i18next-fetch-backend": "^7.0.0",
        "lodash-es": "^4.18.1",
        "react-hook-form": "^7.70.0",
        "react-i18next": "^16.5.1",
        "react-router-dom": "^6.30.4",
        "@keycloak/keycloak-admin-client": "26.8.2",
        "@patternfly/react-styles": "^5.4.1",
        "oidc-spa": "~10.2.17"
    },
    "devDependencies": {
        "@eslint/js": "^9.15.0",
        "@playwright/test": "^1.65.0",
        "@storybook/react": "^8.1.10",
        "@storybook/react-vite": "^8.1.10",
        "@types/react": "^18.2.43",
        "@types/react-dom": "^18.2.17",
        "@typescript-eslint/eslint-plugin": "^8.15.0",
        "@typescript-eslint/parser": "^8.15.0",
        "@vitejs/plugin-react": "^4.2.1",
        "eslint": "^9.15.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-react": "^7.37.2",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.4.14",
        "eslint-plugin-storybook": "^0.11.1",
        "globals": "^15.12.0",
        "prettier": "3.3.1",
        "storybook": "^8.1.10",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.15.0",
        "vite": "^5.0.8",
        "@types/lodash-es": "^4.17.12"
    },
    "engines": {
        "node": "^18.0.0 || >=20.0.0"
    },
    "overrides": {
        "@keycloakify/keycloak-ui-shared": {
            "@keycloak/keycloak-admin-client": "26.8.2"
        }
    }
}
